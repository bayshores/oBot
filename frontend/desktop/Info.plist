<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Lets the app talk to your oBot computer over plain http (e.g. through Tailscale). -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- obot://share#<page>: the "Send to oBot" bookmark opens the app with a page from the browser. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.obot.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>obot</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
